{
  "name": "code-viewer-workbench",
  "version": "1.0.0",
  "type": "module",
  "penguin": {
    "version": "2026.11.11.5",
    "modules": [
      {
        "name": "Workbench",
        "provides": {
          "main": "@prismshadow/penguin-server#WorkbenchMain"
        },
        "contributes": {
          "WebModule.sessionTabs": [
            {
              "id": "code-viewer.preview",
              "key": "code-preview",
              "title": "Code",
              "titleZh": "代码",
              "renderer": {
                "iframe": {
                  "src": "ui/index.html"
                }
              }
            }
          ]
        }
      }
    ]
  }
}
